# ─────────────────────────────────────────────────────────────
# Ouleeh — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA commitear .env.local — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────

# ─── NextAuth ────────────────────────────────────────────────
# URL pública de la app (ej: http://localhost:3000 en desarrollo)
NEXTAUTH_URL=http://localhost:3000

# Secreto para firmar JWT — genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Google OAuth (para login con Google + Google Calendar) ──
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Firebase (cliente — valores públicos del proyecto) ───────
# Obtener en: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Google Maps ─────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
# Habilitar: Maps JavaScript API
# Sin esta key, /explore muestra un placeholder elegante en lugar del mapa real.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── MercadoPago ─────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers → Tus aplicaciones → Credenciales
# Usar credenciales de TEST en desarrollo, PRODUCCIÓN en producción.
# Access Token (server-only — NUNCA con prefijo NEXT_PUBLIC_)
MERCADOPAGO_ACCESS_TOKEN=
# Webhook secret para verificar notificaciones de MP (opcional pero recomendado)
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Sentry (error tracking) ─────────────────────────────────
# Obtener en: https://sentry.io → Settings → Projects → Client Keys (DSN)
# NEXT_PUBLIC_ para el cliente, sin prefijo para el servidor
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Para subir source maps en CI (obtener en Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── WhatsApp Business API ────────────────────────────────────
# Obtener en: https://developers.facebook.com → WhatsApp → Getting Started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── URLs de entorno ─────────────────────────────────────────
# Dominio público de Vercel (se setea automáticamente en Vercel, manual en otros)
# Ejemplo: mujer-app.vercel.app (sin https://)
NEXT_PUBLIC_VERCEL_URL=

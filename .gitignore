# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.example

# firebase
firebase-debug.log
firestore-debug.log

# local agents
.agents/
.claude/
CLAUDE.md

# Imágenes generadas por IA — no subir al repo
images/infographics/*
images/miscellaneous/*
images/people/*
images/photography/*
images/products/*
images/salon/*
images/marketing/*
!images/**/.gitkeep

# Prompts JSON de imágenes generadas
prompts/infographics/*
prompts/miscellaneous/*
prompts/people/*
prompts/photography/*
prompts/products/*
prompts/salon/*
prompts/marketing/*
!prompts/**/.gitkeep
